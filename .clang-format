# generated by ai
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4

# Tell clang-format we want full control over braces
BreakBeforeBraces: Custom
BraceWrapping:
    AfterFunction: true # Microsoft style: Opening brace on a NEW line for functions
    AfterControlStatement: false # Your style: Opening brace on the SAME line for if/while/switch
    BeforeElse: false # Keeps 'else' attached to the closing brace: } else {
    AfterClass: true # Optional: Puts class opening braces on a new line
    AfterStruct: true # Optional: Puts struct opening braces on a new line
